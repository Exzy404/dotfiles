{
  "exclusive": true,
  "reload_style_on_change": true,
  "position": "top",
  "spacing": 0,
  "height": 32,
  "margin-top": 1,
  "width": 450,

  "modules-left": [
    "custom/erick",
    "hyprland/workspaces"
  ],

  "modules-center": [
    "mpris",
    "clock",
    "idle_inhibitor",
    "temperature"
  ],

  "modules-right": [
    "power-profiles-daemon",
    "bluetooth",
    "network",
    "pulseaudio",
    "memory",
    "cpu",
    "battery#0",
    "battery#1",
    "tray"
  ],

"power-profiles-daemon": {
  "format": "{icon}",
  "tooltip-format": "Power profile: {profile}",
  "tooltip": true,
  "format-icons": {
    "default": "",
    "performance": "",
    "balanced": "",
    "power-saver": ""
  }
},
 "temperature": {
    // "thermal-zone": 2,
    // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
    "critical-threshold": 70,
"warning-threshold": 62,
    "format": "",
    "tooltip-format": "{temperatureC}°C"
},
  "hyprland/workspaces": {
    "on-click": "activate",
    "disable-scroll": false,
    "all-outputs": true,
    
    "format": "<span font-family='Draconiano'>{icon}</span>",
    "format-icons": {
      "1": "K",
      "2": "L",
      "3": "M",
      "4": "N",
      "5": "O",
      "6": "P",
      "7": "Q",
      "8": "R",
      "9": "S",
      "10": "T"
    }
  },

  "clock": {
    "format": "{:%H:%M %Y-%m-%d}",
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
    }
  },

  "network": {
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid}",
    "tooltip-format-ethernet": "Ethernet",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "on-click": "kitty -e nmtui"
  },

  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "tooltip-format": "{num_connections} connected",
    "on-click": "kitty -e bluetoothctl"
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "",
    "tooltip-format": "{volume}%",
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "pamixer -t",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    }
  },

  "cpu": {
    "interval": 5,
    "format": "",
    "tooltip-format": "CPU {usage}%",
    "on-click": "kitty -e btop"
  },

  "memory": {
    "interval": 5,
    "format": "",
    "tooltip-format": "{used:0.1f}G used",
    "on-click": "kitty -e btop"
  },

  "battery#0": {
    "bat":"BAT0",
    "format": "{icon}",
    "format-charging": "{icon}",
    "format-plugged": "",
    "format-full": "󰂅",
    "tooltip-format": "BAT0: {capacity}%",
    "tooltip-format-charging": "BAT0: {capacity}% charging",
    "tooltip-format-discharging": "BAT0: {capacity}% discharging",
    "interval": 5,

    "format-icons": {
      "charging": [
        "󰢜",
        "󰂆",
        "󰂇",
        "󰂈",
        "󰢝",
        "󰂉",
        "󰢞",
        "󰂊",
        "󰂋",
        "󰂅"
      ],
      "default": [
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ]
    },

    "states": {
      "warning": 20,
      "critical": 10
    }
  },

  "battery#1": {
    "bat":"BAT1",
    "format": "{icon}",
    "format-charging": "{icon}",
    "format-plugged": "",
    "format-full": "󰂅",
    "tooltip-format": "BAT1: {capacity}%",
    "tooltip-format-charging": "BAT1: {capacity}% charging",
    "tooltip-format-discharging": "BAT1: {capacity}% discharging",
    "interval": 5,

    "format-icons": {
      "charging": [
        "󰢜",
        "󰂆",
        "󰂇",
        "󰂈",
        "󰢝",
        "󰂉",
        "󰢞",
        "󰂊",
        "󰂋",
        "󰂅"
      ],
      "default": [
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ]
    },

    "states": {
      "warning": 20,
      "critical": 10
    }
  },

  "mpris": {
    "format": "{player_icon}",
    "format-paused": "",
    "tooltip-format": "{dynamic}",
    "player-icons": {
      "default": "",
      "mpv": "",
      "spotify": ""
    },
    "ignored-players": [
      "firefox",
      "chromium",
      "brave"
    ],
    "on-click": "playerctl play-pause",
    "max-length": 20
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },

  "tray": {
    "icon-size": 12,
    "spacing": 4,
    "show-passive-items": true
  },

 "custom/erick": {
    "format": "",
    //"on-click": "",
    "on-click-right": "kitty -e neofetch",
    "tooltip-format": "Arigato josaimos"
  },
}


